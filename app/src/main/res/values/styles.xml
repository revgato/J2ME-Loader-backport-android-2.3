<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Platform themes only: API 10 cannot load AppCompat/Material parents. -->
    <style name="AppTheme" parent="android:style/Theme.Black.NoTitleBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="AppTheme.LegacyScreen" parent="android:style/Theme.Black">
        <item name="android:windowNoTitle">false</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
    </style>

    <style name="ButtonStyle">
        <item name="android:minHeight">38dp</item>
        <item name="android:paddingLeft">6dp</item>
        <item name="android:paddingRight">6dp</item>
        <item name="android:background">@drawable/bg_button</item>
    </style>

    <style name="LegacyKeyMapperRow">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="LegacyKeyMapperButton" parent="ButtonStyle">
        <item name="android:layout_width">72dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:minWidth">56dp</item>
    </style>
</resources>
