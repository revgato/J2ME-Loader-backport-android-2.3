<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:installLocation="auto">

    <!-- API 10 has no runtime permission flow. The launcher only needs local SD access. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <uses-feature android:glEsVersion="0x00020000" android:required="false" />

    <application
        android:name="ru.playsoftware.j2meloader.EmulatorApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">
        <activity
            android:name="ru.playsoftware.j2meloader.legacy.LegacyMainActivity"
            android:configChanges="orientation|keyboard|keyboardHidden"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/java-archive" />
                <data android:mimeType="text/vnd.sun.j2me.app-descriptor" />
                <data android:scheme="file" />
            </intent-filter>
        </activity>
        <activity
            android:name="ru.playsoftware.j2meloader.legacy.LegacySettingsActivity"
            android:theme="@style/AppTheme.LegacyScreen"
            android:exported="false" />
        <activity
            android:name="ru.playsoftware.j2meloader.legacy.LegacyProfilesActivity"
            android:theme="@style/AppTheme.LegacyScreen"
            android:exported="false" />
        <activity
            android:name="ru.playsoftware.j2meloader.legacy.LegacyConfigActivity"
            android:theme="@style/AppTheme.LegacyScreen"
            android:exported="false" />
        <activity
            android:name="ru.playsoftware.j2meloader.legacy.LegacyKeyMapperActivity"
            android:theme="@style/AppTheme.LegacyScreen"
            android:configChanges="orientation|keyboard|keyboardHidden"
            android:exported="false" />
        <activity
            android:name="javax.microedition.shell.MicroActivity"
            android:theme="@style/AppTheme.NoActionBar"
            android:configChanges="orientation|keyboard|keyboardHidden"
            android:process=":midlet" />
    </application>
</manifest>
